S3 usagepoll.go:54 usageRaw (background poll)
  argv: claude -p /usage --output-format json --no-session-persistence
  exec.CommandContext(ctx 60s usageRawTimeout usagepoll.go:18); env cleanEnv(0); dir os.TempDir(); cmd.Output()
